{
    "name": "silasjoisten/sf-live-2025",
    "description": "Workshop project for Symfony Live 2025 Berlin",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "^3.10.3",
        "symfony/asset": "^7.3.0",
        "symfony/asset-mapper": "^7.3.5",
        "symfony/dotenv": "^7.3.2",
        "symfony/flex": "^2.10",
        "symfony/framework-bundle": "^7.3.6",
        "symfony/runtime": "^7.3.4",
        "symfony/stimulus-bundle": "^2.31",
        "symfony/string": "^7.3.4",
        "symfony/twig-bundle": "^7.3.4",
        "symfony/ux-turbo": "^2.31",
        "symfony/yaml": "^7.3.5",
        "twig/extra-bundle": "^2.12 || ^3.22.1",
        "twig/twig": "^2.12 || ^3.22",
        "webmozart/assert": "^1.12.1"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.48.2",
        "ergebnis/php-cs-fixer-config": "^6.56.0",
        "fakerphp/faker": "^1.24.1",
        "friendsofphp/php-cs-fixer": "^3.89.2",
        "phpunit/phpunit": "^9.6.29",
        "symfony/browser-kit": "^7.3.6",
        "symfony/css-selector": "^7.3.6",
        "symfony/debug-bundle": "^7.3.5",
        "symfony/maker-bundle": "^1.64.0",
        "symfony/phpunit-bridge": "^7.3.4",
        "symfony/stopwatch": "^7.3.0",
        "symfony/web-profiler-bundle": "^7.3.5",
        "zenstruck/browser": "^1.9.1",
        "zenstruck/foundry": "^2.8.0"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.3.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        }
    }
}
